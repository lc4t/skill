{
  "site": {
    "id": "sakanano-cloud-skills",
    "name": "Agents Init Plugin",
    "description": "可安装的项目初始化器，附带项目生命周期、扩展能力与 Opinion 管理。",
    "version": "0.5.0",
    "updated_at": "2026-09-29",
    "homepage": "./index.html",
    "future_domain": "skill.sakanano.moe"
  },
  "plugin": {
    "manifest": "./plugin.json",
    "version": "6.1.0",
    "install_unit": "repository-root",
    "bundled_plugins": [
      "./plugins/project-orchestrator/plugin.json",
      "./plugins/agent-pack/plugin.json",
      "./plugins/opinion-manager/plugin.json"
    ],
    "agent_install": "./INSTALL.md",
    "llms": "./llms.txt",
    "bootstrap_and_init": "./scripts/bootstrap_and_init.py"
  },
  "skills": [
    {
      "id": "agents-init",
      "name": "agents-init v6 / Project Profile 初始化与迁移",
      "description": "创建或迁移项目骨架；写入前验证同包 project-orchestrator、agent-pack 与 opinion-manager。",
      "version": "6.1.0",
      "status": "stable",
      "entrypoints": {
        "browser": "./skills/agents-init/index.html",
        "agent": "./skills/agents-init/SKILL.md",
        "metadata": "./skills/agents-init/skill.json",
        "template": "./skills/agents-init/AGENT.template.md"
      }
    },
    {
      "id": "project-orchestrator",
      "name": "project-orchestrator / 项目生命周期编排",
      "description": "按项目契约选择 Task/Case、路由 Tool 与叶子 Skill、验证并做受控 Git 交付。",
      "version": "1.4.0",
      "status": "stable",
      "entrypoints": {
        "agent": "./plugins/project-orchestrator/skills/project-orchestrator/SKILL.md",
        "metadata": "./plugins/project-orchestrator/plugin.json"
      }
    },
    {
      "id": "agent-pack",
      "name": "agent-pack / Agent 扩展能力管理",
      "description": "在项目与 Codex / Cursor / Claude 之间盘点、校验、安装、同步、迁移与对账 Plugin、Skill、MCP。",
      "version": "1.5.0",
      "status": "stable",
      "entrypoints": {
        "agent": "./plugins/agent-pack/skills/agent-pack/SKILL.md",
        "metadata": "./plugins/agent-pack/plugin.json",
        "mcp": "./plugins/agent-pack/mcp.json",
        "reference": "./plugins/agent-pack/references/capability-config.md"
      }
    },
    {
      "id": "opinion-manager",
      "name": "opinion-manager / Agent 行为规则管理",
      "description": "管理模板系列、可选变体、精确版本、个人 Profile、锁定快照和升级预览；公开目录当前为空。",
      "version": "0.2.0",
      "status": "experimental",
      "entrypoints": {
        "agent": "./plugins/opinion-manager/skills/opinion-manager/SKILL.md",
        "metadata": "./plugins/opinion-manager/plugin.json",
        "runtime": "./plugins/opinion-manager/runtime/opinion_manager.py"
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Opinion rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "slot", "title", "level", "scopes", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "slot": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "title": {"type": "string", "pattern": "\\S"},
    "level": {"enum": ["required", "preferred"]},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "text": {"type": "string", "pattern": "\\S"}
  }
}

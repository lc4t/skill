{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Opinion template",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "variant", "version", "name", "description", "scopes", "rules"],
  "properties": {
    "family": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "variant": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"type": "string", "pattern": "\\S"},
    "description": {"type": "string", "pattern": "\\S"},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "rules": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.sakanano.moe/plugins/opinion-manager/references/template.schema.json",
  "title": "Opinion template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "scopes", "rules", "questions"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scopes": {"$ref": "#/$defs/nonEmptyStrings"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "scopes", "text"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "level": {"enum": ["required", "preferred"]},
          "scopes": {"$ref": "#/$defs/nonEmptyStrings"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "options"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "prompt": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "recommend"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "recommend": {"$ref": "#/$defs/nonEmptyStrings"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
